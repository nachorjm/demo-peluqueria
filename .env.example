# ─────────────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno del backend.
# Copia este fichero a `.env` y rellena con las credenciales del cliente.
# El `.env` real NO se commitea (esta en .gitignore).
# En produccion (Railway), estas variables se configuran en el panel
# "Variables" del servicio.
# ─────────────────────────────────────────────────────────────────────
#
# Datos especificos del restaurante (nombre, direccion, carta, colores,
# horarios, dominios) NO estan aqui: viven en config/restaurante.yaml.
# ─────────────────────────────────────────────────────────────────────


# ═══ Anthropic (Claude) ═════════════════════════════════════════════
# Obten la key en https://console.anthropic.com
ANTHROPIC_API_KEY=PEGA_TU_ANTHROPIC_API_KEY


# ═══ Supabase ═══════════════════════════════════════════════════════
# Un proyecto Supabase INDEPENDIENTE por cada cliente. Crea uno nuevo
# en https://supabase.com/dashboard, copia la URL y la SERVICE ROLE KEY
# (NO la publishable, esa solo vale para la landing publica).
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_PEGA_TU_KEY

# Token compartido con el Database Webhook de Supabase. Lo eliges tu
# (cualquier string largo aleatorio). Lo configuras tambien en el
# webhook de Supabase como header X-Webhook-Secret.
SUPABASE_WEBHOOK_SECRET=PEGA_UN_SECRETO_LARGO_Y_ALEATORIO


# ═══ Twilio (WhatsApp sandbox) ══════════════════════════════════════
# 1. Crea cuenta en https://www.twilio.com (gratuita)
# 2. Account SID y Auth Token: panel principal de Twilio.
# 3. Activa el WhatsApp Sandbox: Messaging > Try it out > Send a WhatsApp message.
# 4. La palabra clave 'join XXX-YYY' aparece en ese mismo panel.
TWILIO_ACCOUNT_SID=ACPEGA_TU_SID
TWILIO_AUTH_TOKEN=PEGA_TU_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Palabra clave del sandbox Twilio (la que el cliente envia para
# unirse: ej "join produce-go"). Solo se usa en la pagina /demo
# para que el comercial enseñe el flujo. En produccion (numero
# propio) este valor es vacio.
TWILIO_SANDBOX_KEYWORD=join produce-go


# ═══ Vapi (agente telefonico) ═══════════════════════════════════════
# Numero al que llamar para hablar con el agente de voz Lola.
# Formato internacional ej "+34911234567". Si vacio, en /demo
# aparece "Pidelo al comercial".
VAPI_PHONE_NUMBER=


# ═══ Resend (emails al duenno) ══════════════════════════════════════
# Para avisos de nueva reserva y escalacion. Cuando el cliente tenga
# dominio verificado, cambia RESEND_FROM a "Nombre <aviso@dominio.com>".
# Mientras tanto puedes usar el remitente generico de sandbox de Resend.
RESEND_API_KEY=re_PEGA_TU_KEY
RESEND_FROM=<Restaurante> <onboarding@resend.dev>
NOTIFICATIONS_TO=email_del_duenno@ejemplo.com


# ═══ Meta Cloud API (futuro) ════════════════════════════════════════
# Solo necesario cuando se migre del sandbox de Twilio a numero real de
# WhatsApp Business via Meta. Por ahora dejalo vacio.
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v20.0


# ═══ Provider de mensajeria (eleccion en runtime) ═══════════════════
# Valores: 'twilio' (por defecto) o 'meta'.
MESSAGING_PROVIDER=twilio


# ═══ Panel /admin (password sencillo, solo para demo) ══════════════
# Password unico que el duenno introduce al entrar al panel. En
# produccion usa algo largo y aleatorio. Vacio = panel ABIERTO (solo dev).
ADMIN_PASSWORD=CAMBIA_ESTE_PASSWORD

# ═══ Feed iCal del duenno (issue #58) ═══════════════════════════════
# Token unico para el endpoint /admin/ical/reservas.ics. El duenno
# suscribe esa URL en su Google Calendar / Apple Calendar / Outlook
# para ver sus reservas en el movil sin entrar al panel.
#
# Generar uno asi (32+ chars urlsafe):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Si se deja vacio, el endpoint devuelve 503 (feature desactivada).
ICAL_FEED_TOKEN=

# ═══ Logging ════════════════════════════════════════════════════════
# Nivel de log del backend. DEBUG (muy verbose), INFO (default),
# WARNING (silencia info), ERROR. En Railway se cambia sin redeploy.
LOG_LEVEL=INFO


# ═══ CORS (opcional) ════════════════════════════════════════════════
# Origenes permitidos, separados por comas. Si se deja vacia, el backend
# usa los `cors_origins` de config/restaurante.yaml. Solo anadir aqui
# para override temporal en prod sin tocar el YAML.
# CORS_ORIGINS=https://dominio-cliente.com,https://www.dominio-cliente.com
